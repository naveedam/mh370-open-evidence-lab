# ---- Database (native PostgreSQL 14+ with PostGIS 3) ----
# Read-only role used by the API server (SELECT only)
DATABASE_URL=postgres://oel_api:CHANGE_ME@localhost:5432/mh370_oel
# Schema owner — used only by `npm run db:migrate` / `db:seed`. Never expose to the API or browser.
DATABASE_ADMIN_URL=postgres://oel_owner:CHANGE_ME@localhost:5432/mh370_oel
# Ingestion pipeline role (insert/update, no deletes) — Phase 2 Python scripts
DATABASE_INGEST_URL=postgres://oel_ingest:CHANGE_ME@localhost:5432/mh370_oel

# ---- API server ----
PORT=8787
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# ---- Frontend (build-time) ----
# Leave unset when the API is served on the same origin under /api (dev proxy or nginx).
# Set to the full API URL when the frontend is on Vercel and the API is elsewhere.
# VITE_API_URL=https://api.example.org/api
