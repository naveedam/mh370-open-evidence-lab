{
  "name": "mh370-open-evidence-lab",
  "private": true,
  "version": "0.1.3",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "api": "node --env-file-if-exists=.env server/index.ts",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.ts",
    "db:seed": "node --env-file-if-exists=.env scripts/seed.ts",
    "typecheck:server": "tsc -p tsconfig.server.json"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.80.0",
    "maplibre-gl": "^6.19.0",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.7",
    "tailwind-merge": "^3.7.1"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24.19.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.7.0",
    "oxlint": "^1.90.0",
    "postcss": "^8.5.33",
    "tailwindcss": "^3.4.19",
    "typescript": "~7.0.2",
    "vite": "^8.3.6"
  },
  "engines": {
    "node": ">=22.18"
  }
}